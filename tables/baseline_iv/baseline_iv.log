. 
. * Match the sample preparation in master.do.
. import delimited "/Users/wanghaiyu/Desktop/Econ681/cleaned/nlsy_merged.csv", 
> clear
(encoding automatically selected: ISO-8859-1)
(90 vars, 259,852 obs)

. encode race, gen(race_cat)

. encode sex, gen(sex_cat)

. winsor2 wage, cuts(1 99) replace

. gen lnwage = ln(wage)

. gen lnwage100 = 100 * lnwage

. gen exp_2 = exp^2

. gen exp_3 = exp^3

. gen tenure_2 = tenure^2

. gen tenure_3 = tenure^3

. gen double educ_exp = educ * exp

. gen double asvab_exp = asvab * exp

. gen double educ_tenure = educ * tenure

. gen double asvab_tenure = asvab * tenure

. keep if (cohort == 0 & year <= 2004) | cohort == 1
(40,299 observations deleted)

. keep if inrange(job_num, 1, 3)
(163,581 observations deleted)

. 
. local controls educ asvab tenure tenure_2 tenure_3 educ_tenure asvab_tenure /
> //
>     ib1.job_num i.year i.sex_cat i.race_cat

. local endogenous exp exp_2 exp_3 educ_exp asvab_exp

. local instruments potexp potexp_2 potexp_3 educ_potexp asvab_potexp

. local reported educ educ_exp educ_tenure asvab asvab_exp asvab_tenure ///
>     exp exp_2 exp_3 tenure tenure_2 tenure_3

. 
. tempname diagnostics coefficients

. postfile `diagnostics' byte cohort str16 term double F partial_r2 shea_r2 N c
> lusters ///
>     using "`output'/firststage.dta", replace
(file /Users/wanghaiyu/Desktop/Econ681/tables/baseline_iv/firststage.dta not
    found)

. postfile `coefficients' byte cohort str16 term double b se p N clusters r2 //
> /
>     using "`output'/secondstage.dta", replace
(file /Users/wanghaiyu/Desktop/Econ681/tables/baseline_iv/secondstage.dta not
    found)

. 
. foreach c in 0 1 {
  2.     * This single command estimates both stages of the full baseline.
.     ivregress 2sls lnwage100 `controls' (`endogenous' = `instruments') ///
>         if cohort == `c' [pweight = sampleweight], vce(cluster id) first
  3.     estimates store IV_baseline_`c'
  4.     estimates save "`output'/IV_baseline_`c'.ster", replace
  5.     local N_`c' : display %12.0fc e(N)
  6.     local G_`c' : display %12.0fc e(N_clust)
  7.     estat firststage, all
  8.     matrix D = r(singleresults)
  9.     matrix S = r(multiresults)
 10.     matrix FS_`c' = D[1..5,4], D[1..5,3], S[1..5,1]
 11.     matrix rownames FS_`c' = exp exp_2 exp_3 educ_exp asvab_exp
 12.     matrix colnames FS_`c' = F Partial_R2 Shea_R2
 13.     local i = 0
 14.     foreach term of local endogenous {
 15.         local ++i
 16.         post `diagnostics' (`c') ("`term'") (D[`i',4]) (D[`i',3]) ///
>             (S[`i',1]) (e(N)) (e(N_clust))
 17.     }
 18.     foreach term of local reported {
 19.         quietly lincom `term'
 20.         post `coefficients' (`c') ("`term'") (r(estimate)) (r(se)) (r(p)) 
> ///
>             (e(N)) (e(N_clust)) (e(r2))
 21.     }
 22. }
