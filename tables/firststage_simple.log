. 
. import delimited "/Users/wanghaiyu/Desktop/Econ681/cleaned/nlsy_merged.csv", 
> clear
(encoding automatically selected: ISO-8859-1)
(90 vars, 259,852 obs)

. encode race, gen(race_cat)

. encode sex, gen(sex_cat)

. winsor2 wage, cuts(1 99) replace

. gen lnwage100 = 100 * ln(wage)

. keep if (cohort == 0 & year <= 2004) | cohort == 1
(40,299 observations deleted)

. keep if job_num <= 3
(163,581 observations deleted)

. 
. local controls educ asvab tenure i.job_num i.year i.sex_cat i.race_cat

. foreach c in 0 1 {
  2.     * One command estimates the IV model for each cohort.
.     ivregress 2sls lnwage100 `controls' (exp = potexp) ///
>         if cohort == `c' [pweight = sampleweight], vce(cluster id)
  3.     estimates store IV_linear_`c'
  4.     estat firststage
  5.     matrix diagnostics = r(singleresults)
  6.     local partial_r2 = diagnostics[1,3]
  7. 
.     * Display and store the first stage on exactly the same IV sample.
.     regress exp potexp `controls' if e(sample) ///
>         [pweight = sampleweight], vce(cluster id)
  8.     test potexp
  9.     estadd scalar excluded_F = r(F)
 10.     estadd scalar partial_r2 = `partial_r2'
 11.     estimates store FS_linear_`c'
 12. }
(sum of wgt is   8.4035e+07)
