	abstract = {This paper argues that adverse selection in the labour market, when viewed as part of a three-way interaction among workers, their current employers and a universe of alternative employers, may seriously impair a worker's freedom to change jobs. When current employers are better informed about the abilities of their workers than potential alternative employers, they will presumably concentrate their efforts to prevent turnover on their better workers. If these efforts lead to fewer quits among better workers, the stream of job changes should be composed disproportionately of less able ones. This will inhibit turnover in two ways. First, firms should be unwilling to hire from the job-changing pool except at low wages. Second, workers who change jobs are marked by being part of an inferior group, which lowers their future bargaining power and wages. Models of these phenomena can be made to account for many aspects of observed labour market behaviour.},
	number = {3},
	urldate = {2026-09-29},
	journal = {The Review of Economic Studies},
	publisher = {[Oxford University Press, Review of Economic Studies, Ltd.]},
	author = {Greenwald, Bruce C.},
	year = {1986},
	pages = {325--347},
	file = {JSTOR Full Text PDF:/Users/wanghaiyu/Zotero/storage/QNRSZXFV/Greenwald - 1986 - Adverse Selection in the Labour Market.pdf:application/pdf},
}

