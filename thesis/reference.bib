	file = {Full Text PDF:/Users/wanghaiyu/Zotero/storage/ZTAIGCLY/Roys and Taber - 2019 - Skill Prices, Occupations, and Changes in the Wage Structure for Low Skilled Men.pdf:application/pdf},
}
