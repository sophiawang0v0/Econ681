	pages = {165--205},
	file = {Full Text PDF:/Users/wanghaiyu/Zotero/storage/RYNWBTWA/Kahn - 2013 - Asymmetric Information between Employers.pdf:application/pdf},
}

@article{castex_changing_2014,
