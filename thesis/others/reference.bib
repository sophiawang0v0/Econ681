	volume = {32},
	url = {https://www.journals.uchicago.edu/doi/10.1086/676018},
	doi = {10.1086/676018},
	abstract = {This study examines changes in returns to formal education and cognitive skills over the past 20 years using the 1979 and 1997 waves of the National Longitudinal Survey of Youth. We show that cognitive skills had a 30\%–50\% larger effect on wages in the 1980s than in the 2000s. Returns to education were higher in the 2000s. These developments are not explained by changing distributions of workers’ observable characteristics or by changing labor market structure. We show that the decline in returns to ability can be attributed to differences in the growth rate of technology between the 1980s and 2000s.},
	number = {4},
	urldate = {2026-07-31},
	journal = {Journal of Labor Economics},
	publisher = {The University of Chicago Press},
	author = {Castex, Gonzalo and Dechter, Evgenia},
