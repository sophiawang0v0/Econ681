@article{schonberg_testing_2007,
	title = {Testing for {Asymmetric} {Employer} {Learning}},
	volume = {25},
	url = {https://www.journals.uchicago.edu/doi/full/10.1086/522905},
	doi = {10.1086/522905},
	abstract = {Recent evidence suggests that employers acquire more precise information about a worker’s productivity the more time he or she spends in the labor market. The following question arises: Is learning symmetric, that is, do all employers have the same information about workers’ productivity, or is learning asymmetric, that is, does the current employer have superior information about workers’ productivity? This article develops a learning model with endogenous mobility that nests both learning hypotheses. It then proposes new tests for asymmetric employer learning. Overall, learning appears to be mostly symmetric, except possibly when the employees involved are college graduates.},
	number = {4},
	urldate = {2026-08-07},
	journal = {Journal of Labor Economics},
	publisher = {The University of Chicago Press},
	author = {Schönberg, Uta},
	month = oct,
	year = {2007},
	pages = {651--691},
	file = {Full Text PDF:/Users/wanghaiyu/Zotero/storage/HYWTYUID/Schönberg - 2007 - Testing for Asymmetric Employer Learning.pdf:application/pdf},
}

